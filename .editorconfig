root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.{cs,csx}]
indent_size = 4
csharp_new_line_before_open_brace = all
csharp_prefer_braces = true:warning
dotnet_diagnostic.IDE0055.severity = warning

[*.{json,jsonc,yml,yaml,md,ps1,py,sh,toml,xml,props,targets,csproj,slnx}]
indent_size = 2

[*.py]
indent_size = 4

# xUnit test names use sentence-like underscores to keep large failure lists readable.
[native/tests/**/*.cs]
dotnet_diagnostic.CA1707.severity = none
